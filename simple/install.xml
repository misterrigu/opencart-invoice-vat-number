<?xml version="1.0" encoding="utf-8"?>
<modification>
  <name>Rigu - Invoice VAT / Tax Number (Simple)</name>
  <code>rigu_invoice_tax_number_simple</code>
  <version>1.0.0</version>
  <author>Rigu</author>
  <link>https://rigu.co.uk</link>

  <!--
    EDIT THESE TWO VALUES BEFORE INSTALLING:
    Label: VAT No.
    Number: YOUR VAT NUMBER
  -->

  <file path="admin/view/template/sale/order_invoice.twig">
    <operation>
      <search><![CDATA[
            <b>{{ text_website }}</b> <a href="{{ order.store_url }}">{{ order.store_url }}</a></td>
      ]]></search>
      <add position="replace"><![CDATA[
            <b>{{ text_website }}</b> <a href="{{ order.store_url }}">{{ order.store_url }}</a><br/>
            <b>VAT No.</b> YOUR VAT NUMBER</td>
      ]]></add>
    </operation>
  </file>
</modification>
